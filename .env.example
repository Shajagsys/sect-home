# PostgreSQL connection string
DATABASE_URL=postgres://postgres:postgres@localhost:5432/secureedge_crm

# Secret used to sign the login session token (use a long random string in production)
AUTH_SECRET=change-me-to-a-long-random-secret

# Credentials for the seeded admin user (used by `npm run db:seed`)
ADMIN_EMAIL=admin@secureedge.in
ADMIN_PASSWORD=ChangeMe123!

# Public URL of the app (used in notification email links)
APP_URL=http://localhost:3000

# Email notifications for new leads (optional — leave unset to disable).
# NOTIFY_EMAILS is comma-separated.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="SecureEdge CRM <crm@secureedge.in>"
NOTIFY_EMAILS=

# Google reCAPTCHA
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=

# Company contact + social media (all optional; defaults in src/lib/company.ts)
NEXT_PUBLIC_COMPANY_EMAIL=contact@sectech.app
NEXT_PUBLIC_COMPANY_PHONE=+91 9812451305
NEXT_PUBLIC_COMPANY_WHATSAPP=919812451305
NEXT_PUBLIC_COMPANY_ADDRESS="Shop No.28, Sohna Road, Central Market Dharuhera, Rewari 123106"
NEXT_PUBLIC_SOCIAL_LINKEDIN=
NEXT_PUBLIC_SOCIAL_X=
NEXT_PUBLIC_SOCIAL_FACEBOOK=
NEXT_PUBLIC_SOCIAL_INSTAGRAM=
NEXT_PUBLIC_SOCIAL_YOUTUBE=

